# Bedrock generation uses bearer authentication.
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_bearer_token
AWS_REGION=us-west-2

COMPOSIO_API_KEY=ak_your_composio_api_key
COMPOSIO_CONNECTED_ACCOUNT_ID=ca_your_connected_account_id
COMPOSIO_USER_ID=your_composio_user_id
INSTAGRAM_USER_ID=your_instagram_user_id

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

NICHE=wide_lifestyle
CONTENT_TYPES=guide,story,tip,scene,how-to,showcase

# Local publication state. Use one shared backend for every publisher of an account.
STATE_BACKEND=local
STATE_PATH=data/publication_state.json
# GitHub Actions supplies these automatically; configure only for shared local operations.
# STATE_BACKEND=github
# STATE_REPOSITORY=owner/repository
# STATE_GITHUB_TOKEN=your_repository_contents_token
STATE_BRANCH=autopilot-state

# Optional location/discovery services.
META_USER_ACCESS_TOKEN=
GUARDIAN_API_KEY=

# Optional Reels: S3 output plus IAM read access, ffmpeg, and validated local audio.
S3_VIDEO_BUCKET=
ALLOW_SILENT_REELS=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
